{
  "expo": {
    "name": "KoreLife",
    "slug": "korelife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/463693ee-ac01-475d-9ea7-061d491c3f88"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.korelife.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "KoreLife utiliza Face ID / Touch ID para proteger tus datos financieros y autenticar tu sesión de forma segura.",
        "NSCameraUsageDescription": "KoreLife necesita acceso a la cámara para escanear facturas y códigos de pago.",
        "NSPhotoLibraryUsageDescription": "KoreLife necesita acceso a la galería para adjuntar comprobantes de pago o cambiar tu foto de perfil.",
        "UIRequiresFullScreen": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "package": "com.korelife.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "korelife",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir a KoreLife utilizar Face ID para proteger tu cuenta y finanzas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a KoreLife acceder a tus fotos para seleccionar comprobantes y fotos de perfil."
        }
      ],
      "expo-notifications",
      "expo-document-picker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "463693ee-ac01-475d-9ea7-061d491c3f88"
      }
    }
  }
}
